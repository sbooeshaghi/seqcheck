      },
      "mutation": "rename_or_alias_the_input_without_changing_its_bytes",
      "expected_seqspec_check": "not_applicable",
      "target": {
        "process_outcome": "failure",
        "checks": [
          "input_check"
        ],
        "assessment_codes": [],
        "metric_names": [],
